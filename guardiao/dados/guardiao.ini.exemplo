# Guardião — configuração.   Abra com: guardiao configurar
# Este arquivo tem senhas: fica só com permissão do seu usuário (600).

[geral]
# onde ficam os snapshots e os logs baixados
pasta = ~/Guardiao
# alerta quando o número de linhas da config cair mais que isto (%)
queda_linhas_pct = 30
# comando extra chamado em ALERTA/ERRO; a mensagem vem em $GUARDIAO_MSG
# exemplos:
#   alerta_cmd = snmptrap -v2c -c public 10.0.0.50 '' 1.3.6.1.4.1.8072.2.3.0.1 1.3.6.1.4.1.8072.2.3.2.1 s "$GUARDIAO_MSG"
#   alerta_cmd = curl -s -d "$GUARDIAO_MSG" https://ntfy.sh/meu-canal
alerta_cmd =

# Uma seção por SYS (cada controladora tem IP próprio).
[sys-slot1]
host = 192.168.0.11
usuario = admin
senha = TROCAR
passivo = sim
# só para "guardiao restaurar --carregar" (snmpset utilCmdLoad)
comunidade_escrita =

[sys-slot2]
host = 192.168.0.12
usuario = admin
senha = TROCAR
passivo = sim
comunidade_escrita =
